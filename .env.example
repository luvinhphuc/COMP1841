# Application runtime
APP_ENV=development

# Primary MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uog_discussion_db
DB_USERNAME=root
DB_PASSWORD=""
DB_CHARSET=utf8mb4

# Outbound SMTP transport
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=10
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Coursework Forum"

# Contact-form notification recipient
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="Administrator"
